# ============================================================
#  .gitignore — C/C++, C# .NET, Windows
# ============================================================


# ------------------------------------------------------------
#  C / C++
# ------------------------------------------------------------

# Compiled object files
*.o
*.obj
*.lo
*.slo

# Precompiled headers
*.gch
*.pch

# Static & shared libraries
*.lib
*.a
*.la
*.lai
*.so
*.so.*
*.dylib
*.dll

# Executables
*.exe
*.out
*.app

# Debug symbols
*.pdb
*.ilk
*.map

# CMake
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
cmake_uninstall.cmake
CTestTestfile.cmake
Makefile
install_manifest.txt
_deps/
out/
out-*/
build/
Build/
build-*/
Build-*/
Debug/
Release/
RelWithDebInfo/
MinSizeRel/
x64/
x86/
Win32/
ARM/
ARM64/

**/x64/**

# x64 + configuration combos (CMake, MSBuild, custom)
x64/**
x64/Debug/
x64/Release/
x64/RelWithDebInfo/
x64/MinSizeRel/
x86/Debug/
x86/Release/
Win32/Debug/
Win32/Release/
ARM64/Debug/
ARM64/Release/

# Named build directories with platform suffixes
build-x64/
build-x86/
build-win32/
build-arm64/
build-debug/
build-release/
build-x64-debug/
build-x64-release/
build-x86-debug/
build-x86-release/

# CMake preset output folders (CMakePresets.json style)
out/build/
out/build-*/
out/install/
out/install-*/

# Visual Studio C++ specific
*.aps
*.ncb
*.opensdf
*.sdf
*.cachefile
*.VC.db
*.VC.VC.opendb
ipch/
*.idb

# Ninja
.ninja_deps
.ninja_log


# ------------------------------------------------------------
#  C# / .NET
# ------------------------------------------------------------

# Build outputs
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# NuGet
*.nupkg
*.snupkg
**/[Pp]ackages/
!**/[Pp]ackages/build/
*.nuget.props
*.nuget.targets
project.lock.json
project.fragment.lock.json
artifacts/
packages/

# .NET CLI / SDK
.dotnet/
.tools/
*.binlog

# Publish output
**/publish/
**/PublishProfiles/

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# Visual Studio cache / options
.vs/
*.vscontent

# ASP.NET / Razor
BundleConfig.cs
ClientApp/dist/

# Entity Framework migrations (keep source, ignore snapshots if preferred)
# *.Designer.cs  ← uncomment only if you want to ignore EF migration designers

# Test results
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*
*.trx
*.coverage
*.coveragexml
TestResults/
coverage*/

# ReSharper
_ReSharper*/
*.DotSettings.user

# Rider
.idea/
*.sln.iml

# Benchmarks
BenchmarkDotNet.Artifacts/


# ------------------------------------------------------------
#  Visual Studio (shared)
# ------------------------------------------------------------

*.pidb
*.svclog
*.scc
_UpgradeReport_Files/
Backup*/
UpgradeLog*.XML
UpgradeLog*.htm
ServiceFabricBackup/

# Visual Studio profiler
*.psess
*.vsp
*.vspx
*.sap

# Code coverage
*.gpState

# NCrunch
_NCrunch_*
.*crunch*.local.xml
nCrunchTemp_*

# Specflow
*.feature.cs

# Publish settings (may contain credentials)
*.pubxml
*.publishproj


# ------------------------------------------------------------
#  Windows
# ------------------------------------------------------------

Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/
*.lnk
*.stackdump

# Windows installer
*.cab
*.msi
*.msix
*.msm
*.msp


# ------------------------------------------------------------
#  Editors & Tools
# ------------------------------------------------------------

# VS Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# JetBrains (CLion, Rider)
.idea/
*.iml

# Sublime Text
*.sublime-workspace

# Vim / Emacs swap
*~
*.swp
*.swo
[._]*.s[a-v][a-z]
[._]*.sw[a-p]

# macOS (if team has mixed OS)
.DS_Store
.AppleDouble
.LSOverride


# ------------------------------------------------------------
#  Misc
# ------------------------------------------------------------

*.tmp
*.temp
*.bak
*.orig
*.log